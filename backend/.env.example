# Copy to .env for local development. Every value below can instead be set as a host environment variable.

# ---- CORS (the UI origin) --------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Vercel preview and production URLs are allowed by this pattern:
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ---- LLM: template | github | openai_compat | azure ---------------------------------
LLM_PROVIDER=template
LLM_MODEL=openai/gpt-4o-mini
# Only seeds listed here may call the LLM (spend guard). Other seeds use templates.
LLM_SEED_ALLOWLIST=40
# github:
GITHUB_TOKEN=
# openai_compat (any OpenAI-compatible endpoint):
LLM_BASE_URL=
LLM_API_KEY=
# azure (Azure OpenAI / Microsoft Foundry deployment):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ---- Storage: auto | memory | sql | cosmos ------------------------------------------
STORE_PROVIDER=auto
# Neon (or any Postgres). Leave empty for a local SQLite file.
DATABASE_URL=
SQLITE_PATH=data/match_insights.db
# cosmos (Azure Cosmos DB; also pip install azure-cosmos):
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=match-insights
COSMOS_CONTAINER=bundles
